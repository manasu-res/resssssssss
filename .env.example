# ==============================================================================
# MANASU RESTAURANT - SUPABASE & APP ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and fill in your values from Supabase:
# Supabase Dashboard -> Project Settings -> API

# Public Project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Service Role Secret Key (SERVER-ONLY - NEVER expose to client/browser)
# Used exclusively by Next.js server route handlers to verify customer table tokens,
# query price snapshots, and write customer orders.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# App Base URL (Used for generating table QR codes and customer links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
